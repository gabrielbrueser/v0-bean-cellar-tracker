rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow reads/writes with App Check token
    // When App Check enforcement is ON in Firebase Console,
    // only requests with valid App Check tokens will be allowed.
    // Until then, these rules allow access for development.
    
    match /doseTypes/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /counters/{docId} {
      allow read, write: if true;
    }

    match /vials/{docId} {
      allow read, write: if true;
    }

    match /coffees/{docId} {
      allow read, write: if true;
    }

    match /processMethods/{docId} {
      allow read, write: if true;
    }

    match /fillSessions/{docId} {
      allow read, write: if true;
    }

    match /usageLogs/{docId} {
      allow read, write: if true;
    }
  }
}
